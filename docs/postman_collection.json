{
  "info": {
    "name": "Online Learning Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Week 5 assignment — Laravel 12 API. Base URL: http://127.0.0.1:8000/api\n\nSeeded sample credentials (password for all: password):\n  Teacher: alice@example.com\n  Teacher: bob@example.com\n  Student: carol@example.com (enrolled in courses 1 and 4)\n  Student: dan@example.com\n  Student: eve@example.com\n\nRun '01 Login (Teacher)' first. The test script saves the token to the {{token}} variable automatically."
  },
  "variable": [
    { "key": "base_url",      "value": "http://127.0.0.1:8000/api" },
    { "key": "token",         "value": "" },
    { "key": "course_id",     "value": "1" },
    { "key": "draft_course_id", "value": "3" },
    { "key": "lesson_id",     "value": "1" },
    { "key": "assignment_id", "value": "1" },
    { "key": "category_id",   "value": "1" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "01 Login (Teacher) — 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.test('Token saved', function() { pm.expect(json.token).to.be.a('string'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",       "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "02 Login (Student) — 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.test('Token saved', function() { pm.expect(json.token).to.be.a('string'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",       "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carol@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "03 Login — Wrong password — 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",       "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "04 Login — Missing fields — 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept",       "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "05 GET /me — 200",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept",         "value": "application/json" },
              { "key": "Authorization",  "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        },
        {
          "name": "06 GET /me — No token — 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        }
      ]
    },
